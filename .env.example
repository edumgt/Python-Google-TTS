APP_ENV=local

# OPENAI_API_KEY는 환경별 파일(.env.local/.env.dev/.env.prod)에서 관리 권장
# 비워두면 LM Studio 로컬 모드로 동작합니다
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# LM Studio / Ollama 설정 (OPENAI_API_KEY가 없을 때 사용)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model

# Upstage Solar 설정 (선택)
# https://console.upstage.ai 에서 발급
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1/solar
UPSTAGE_MODEL=solar-pro2

# 기본 AI 모델 선택 (auto, openai, ollama, solar)
DEFAULT_AI_PROVIDER=auto

DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
APP_TIME_ZONE=Asia/Seoul
